{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.billboard/schemas/release/lambda-release-manifest.v1.schema.json",
  "title": "LambdaReleaseManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "createdAt",
    "service",
    "git",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "releaseId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "service": {
      "type": "string",
      "enum": ["billboard-services"]
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "git": {
      "title": "ReleaseGitRefV1",
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commitSha"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/lambdaArtifact" }
    }
  },
  "$defs": {
    "lambdaArtifact": {
      "title": "LambdaArtifactV1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logicalName",
        "functionName",
        "runtime",
        "handler",
        "s3Bucket",
        "s3Key",
        "sha256"
      ],
      "properties": {
        "logicalName": {
          "type": "string",
          "minLength": 1
        },
        "functionName": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "title": "LambdaRuntimeV1",
          "type": "string",
          "enum": ["nodejs20.x", "nodejs22.x", "nodejs24.x"]
        },
        "handler": {
          "type": "string",
          "minLength": 1
        },
        "s3Bucket": {
          "type": "string",
          "minLength": 3
        },
        "s3Key": {
          "type": "string",
          "minLength": 1
        },
        "releaseS3Key": {
          "type": "string",
          "minLength": 1
        },
        "s3ObjectVersion": {
          "type": "string",
          "minLength": 1
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
