{
    "name": "billboard-services",
    "version": "1.0.0",
    "private": true,
    "description": "",
    "main": "index.js",
    "scripts": {
        "test": "jest",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --max-warnings 0",
        "format": "prettier --write \"{src,scripts}/**/*.{ts,cjs,js,mjs}\"",
        "format:check": "prettier --check \"{src,scripts}/**/*.{ts,cjs,js,mjs}\"",
        "build": "node scripts/buildAll.cjs",
        "backfill:bills-manifest": "node scripts/backfillBillsManifest.cjs",
        "backfill:bill-status": "node -r ts-node/register/transpile-only scripts/backfillBillStatus.ts",
        "backfill:bill-companions": "node -r ts-node/register/transpile-only scripts/backfillBillCompanions.ts",
        "backfill:congress-member-stats": "node scripts/backfillCongressMemberStats.cjs",
        "backfill:manifest-vote-counts": "node -r ts-node/register/transpile-only scripts/backfillManifestVoteCounts.ts",
        "repair:official-vote-tallies": "node -r ts-node/register/transpile-only scripts/repairOfficialVoteTallies.ts",
        "repair:house-vote-counts": "node -r ts-node/register/transpile-only scripts/repairHouseVoteCounts.ts",
        "repair:failed-status": "node -r ts-node/register/transpile-only scripts/repairFailedStatus.ts",
        "repair:finalized-status": "node -r ts-node/register/transpile-only scripts/repairFinalizedStatus.ts",
        "reconcile:processed-bills": "node -r ts-node/register/transpile-only scripts/reconcileProcessedBills.ts",
        "backfill:congress-member-legislative-profiles": "node scripts/backfillCongressMemberLegislativeProfiles.cjs",
        "backfill:cosponsors": "node -r ts-node/register/transpile-only scripts/backfillCosponsors.ts",
        "benchmark:civic-profiles": "node -r ts-node/register/transpile-only scripts/benchmarkCongressMemberCivicProfiles.ts",
        "eval:summaries": "node -r ts-node/register/transpile-only scripts/evalSummaries.ts",
        "eval:compare-priority": "node -r ts-node/register/transpile-only scripts/comparePriorityModels.ts",
        "probe:bedrock": "node -r ts-node/register/transpile-only scripts/probeBedrockModel.ts",
        "replay:member-votes": "node -r ts-node/register/transpile-only scripts/replayCongressVoteProfiles.ts",
        "relabel:sub-categories": "node -r ts-node/register/transpile-only scripts/relabelSubCategories.ts",
        "relabel:ceremonial-rows": "node -r ts-node/register/transpile-only scripts/relabelCeremonialRows.ts",
        "update:disposable-domains": "node -r ts-node/register/transpile-only scripts/updateDisposableDomains.ts",
        "backfill:signup-email-claims": "node -r ts-node/register/transpile-only scripts/backfillSignUpEmailClaims.ts",
        "report:app-attest": "node -r ts-node/register/transpile-only scripts/reportAppAttest.ts",
        "refetch:stale-bills": "node -r ts-node/register/transpile-only scripts/refetchStaleBills.ts",
        "list:skipped-bill-updates": "node -r ts-node/register/transpile-only scripts/listSkippedBillUpdates.ts",
        "list:backfill-leftovers": "node -r ts-node/register/transpile-only scripts/listBackfillLeftovers.ts",
        "redate:manifest-rows": "node -r ts-node/register/transpile-only scripts/redateManifestRows.ts",
        "reprocess:congress-members": "node -r ts-node/register/transpile-only scripts/reprocessCongressMembers.ts",
        "send:district-notice": "node -r ts-node/register/transpile-only scripts/sendDistrictNotice.ts",
        "clear:stored-party": "node -r ts-node/register/transpile-only scripts/clearStoredParty.ts",
        "expire:old-weekly-briefs": "node -r ts-node/register/transpile-only scripts/expireOldWeeklyBriefs.ts",
        "release:manifest": "node scripts/generateReleaseManifest.cjs",
        "release:package-lambdas": "node scripts/packageLambdas.cjs"
    },
    "keywords": [],
    "author": "",
    "license": "Apache-2.0",
    "type": "commonjs",
    "dependencies": {
        "@aws-sdk/client-bedrock-runtime": "^3.936.0",
        "@aws-sdk/client-cloudwatch": "^3.913.0",
        "@aws-sdk/client-cognito-identity-provider": "^3.936.0",
        "@aws-sdk/client-dynamodb": "^3.911.0",
        "@aws-sdk/client-s3": "^3.911.0",
        "@aws-sdk/client-secrets-manager": "^3.913.0",
        "@aws-sdk/client-sns": "^3.911.0",
        "@aws-sdk/client-sqs": "^3.911.0",
        "@aws-sdk/client-ssm": "^3.1002.0",
        "@aws-sdk/s3-request-presigner": "^3.1014.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/aws-lambda": "^8.10.156",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.7.2",
        "esbuild": "^0.25.11",
        "eslint": "~10.10.0",
        "jest": "^30.5.2",
        "prettier": "^3.6.2",
        "ts-jest": "^29.4.5",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "~8.70.0"
    },
    "overrides": {
        "babel-plugin-istanbul": {
            "test-exclude": "^8.0.0"
        }
    },
    "allowScripts": {
        "esbuild@0.25.12": true,
        "@parcel/watcher": false
    }
}
